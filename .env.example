# Copy to .env.local and fill in. Never commit .env.local.
# Required only for AI features (card generation, tutor, answer checking).
# Revision, scheduling and storage work without it.
OPENAI_API_KEY=
# Any chat-completions model that supports JSON-schema structured output.
OPENAI_MODEL=gpt-4o-mini
# Change to use another OpenAI-compatible provider.
OPENAI_BASE_URL=https://api.openai.com/v1
