# Copy to .env.local and fill in. Never commit .env.local.
# Required only for AI features (card generation, tutor, answer checking).
# Revision, scheduling and storage work without it.
OPENAI_API_KEY=
# Any chat-completions model that supports JSON-schema structured output.
OPENAI_MODEL=gpt-4o-mini
# Change to use another OpenAI-compatible provider.
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Cloud sync (optional) ---------------------------------------------------
# From your Supabase project: Project Settings -> API. Use the project URL and the PUBLIC key
# (called "anon" or "publishable"). NEVER put the secret / service_role key anywhere in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
